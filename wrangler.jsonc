{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cqu-moe-homepage",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "cqu.moe", "custom_domain": true }]
}
